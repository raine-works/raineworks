{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["bun", "react", "react-dom"],
		"paths": {
			"@/*": ["./src/*"],
			"@web": ["./src/index.tsx"],
			"@web/*": ["./src/*"],
			"@app/web": ["./src/index.tsx"],
			"@app/web/*": ["./src/*"],
			"@tools": ["../tools/src/index.ts"],
			"@tools/*": ["../tools/src/*"],
			"@app/tools": ["../tools/src/index.ts"],
			"@app/tools/*": ["../tools/src/*"]
		}
	},
	"include": ["src/**/*", "scripts/**/*"]
}
