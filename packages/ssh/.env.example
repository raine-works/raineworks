# Copied to .env.local by `bun run dev:init`, which Bun loads for `bun run start` here. `bun run dev` sets these
# itself. Every setting has a default (`src/main.ts`, `src/server/limits.ts`).
SSH_PORT=2222
# The development host key `bun run dev:init` makes. Never production's: that comes from its environment.
SSH_HOST_KEY_PATH=.dev/host_key
# SSH_MAX_CONNECTIONS=200
# SSH_MAX_PER_IP=5
# SSH_RATE_PER_IP=10
