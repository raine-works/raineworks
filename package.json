{
	"name": "raineworks",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "bun run --filter @raineworks/server --filter @raineworks/ssh build",
		"build:web": "bun run --parallel --filter '@raineworks/web-*' build",
		"clean": "find . -name node_modules -type d -prune -exec rm -rf {} + && find packages -name dist -type d -prune -exec rm -rf {} +",
		"dev": "bun run --parallel --filter '@raineworks/web-*' --filter @raineworks/server dev",
		"dev:kill": "bun scripts/kill-ports.ts",
		"format": "bun fmt",
		"images": "bun packages/tools/src/images-cli.ts",
		"lint": "bun fmt --check",
		"lint:fix": "bun fmt",
		"release": "bun packages/tools/src/release-cli.ts",
		"start": "bun run --filter @raineworks/server start",
		"test": "bun run --sequential --filter '*' test",
		"typecheck": "bun check -b",
		"start:ssh": "bun run --filter @raineworks/ssh start"
	},
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@fontsource-variable/geist": "5.3.0",
			"@fontsource-variable/geist-mono": "5.3.0",
			"@tanstack/react-query": "5.107.1",
			"@tanstack/react-router": "1.170.46",
			"@ui-sdk/core": "0.1.0-beta.10",
			"@ui-sdk/react": "0.1.0-beta.10",
			"class-variance-authority": "0.7.1",
			"clsx": "2.1.1",
			"highlight.js": "11.12.0",
			"hono": "4.13.17",
			"ink": "8.0.0",
			"lucide-react": "1.63.0",
			"radix-ui": "1.8.1",
			"react": "19.3.1",
			"react-dom": "19.3.1",
			"sonner": "2.0.8",
			"ssh2": "1.17.0",
			"tailwind-merge": "3.7.0",
			"tw-animate-css": "1.4.0",
			"zod": "4.6.7"
		},
		"catalogs": {
			"dev": {
				"@types/bun": "1.4.4",
				"@types/react": "19.3.0",
				"@types/react-dom": "19.3.0",
				"@types/ssh2": "1.15.6",
				"bun-plugin-tailwind": "0.1.2",
				"ink-testing-library": "4.0.0",
				"tailwindcss": "4.3.5"
			}
		}
	},
	"devDependencies": {
		"@raineworks/tools": "workspace:*",
		"@raineworks/tsconfig": "workspace:*",
		"@types/bun": "catalog:dev"
	},
	"engines": {
		"bun": "1.4.4"
	},
	"packageManager": "bun@1.4.4"
}
