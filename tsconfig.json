{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["bun"],
		"paths": {
			"@/*": [
				"./packages/backend/src/*",
				"./packages/web/src/*",
				"./packages/ssh/src/*",
				"./packages/tools/src/*"
			],
			"@backend": ["./packages/backend/src/index.ts"],
			"@backend/*": ["./packages/backend/src/*"],
			"@web": ["./packages/web/src/index.tsx"],
			"@web/*": ["./packages/web/src/*"],
			"@ssh/*": ["./packages/ssh/src/*"],
			"@tools": ["./packages/tools/src/index.ts"],
			"@tools/*": ["./packages/tools/src/*"],
			"@app/backend": ["./packages/backend/src/index.ts"],
			"@app/backend/*": ["./packages/backend/src/*"],
			"@app/web": ["./packages/web/src/index.tsx"],
			"@app/web/*": ["./packages/web/src/*"],
			"@app/ssh/*": ["./packages/ssh/src/*"],
			"@app/tools": ["./packages/tools/src/index.ts"],
			"@app/tools/*": ["./packages/tools/src/*"]
		}
	}
}
